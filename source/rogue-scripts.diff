+; live feed for the browser side panel
+local-script RogueLive@2424 {
+    var f line sig last pus lastpu quit jz i cnt lastc hl lasthl spd kk
+
+    last = -1
+    lastpu = -1
+    lastc = -1
+    lasthl = -1
+    quit = 0
+    do {
+        start-script RogueCalcBoost
+        sig = gBatterKid + 300 * (gRogueOn + 4 * ((min gRogueAbPitches 1) + 2 * ((min gRogueAbFouls 15) + 16 * (gCurrentSwing + 9 * (gNumOuts + 4 * (gBattingTeamInfoIndex + 2 * (min gCurrentHalfInning 2)))))))
+        jz = 0
+        pus = 0
+        if (gPitcherPitches && g_maybe_powerup_state) {
+            for i = 1 to 10 + {
+                if (gPitcherPitches[0][i] / 10 == 26) {
+                    jz = gPitcherPitches[0][i] % 10 + 1
+                }
+            }
+            pus = g_maybe_powerup_state[0][1] + 10 * g_maybe_powerup_state[0][2] + 100 * g_maybe_powerup_state[0][3] + 1000 * g_maybe_powerup_state[0][4] + 10000 * jz
+        }
+        if (gRogueSpdD > 0 || gRogueSpdT > 0) {
+            spd = gRogueDbl * gRogueSpdD + gRogueTrp * gRogueSpdT
+            if (spd != gRogueSpdApplied) {
+                for i = 0 to 8 + {
+                    kk = gPickOrder1[i]
+                    if (kk > 0) {
+                        gKidData[kk][KD-SPEED] = max 0 (min (gKidData[kk][KD-SPEED] + spd - gRogueSpdApplied) 125)
+                    }
+                }
+                gRogueSpdApplied = spd
+            }
+        }
+        cnt = gNumBalls + 5 * gNumStrikes + 20 * (min gRogueAbPitches 99)
+        hl = gCurrentHalfInning + 100 * gGameLength + 10000 * (gTeamInfo[0][TI-RUNS] + 100 * gTeamInfo[1][TI-RUNS]) + 50000000 * (min (gRogueDbl + 3 * gRogueTrp) 20)
+        cnt = cnt + 4000 * gKidData[gBatterKid][KD-fatigue]
+        if ((sig != last || pus != lastpu || cnt != lastc || hl != lasthl) && gPitcherPitches && g_maybe_powerup_state) {
+            lasthl = hl
+            last = sig
+            lastpu = pus
+            lastc = cnt
+            sprintf f "%srogue_live.ini" gSaveGamePath
+            sprintf line "%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d" gRogueSeq gBatterKid gBattingTeamInfoIndex gRogueOn gRogueAbPitches gRogueAbFouls gCurrentSwing gNumOuts gCurrentHalfInning gRogueBP gRogueBC g_maybe_powerup_state[0][1] g_maybe_powerup_state[0][2] g_maybe_powerup_state[0][3] g_maybe_powerup_state[0][4] jz gNumBalls gNumStrikes gGameLength gTeamInfo[0][TI-RUNS] gTeamInfo[1][TI-RUNS] gKidData[gBatterKid][KD-fatigue] (2 * gGameStats[gBatterKid][STAT-HITS] - gGameStats[gBatterKid][STAT-AT-BATS]) gRogueDbl gRogueTrp gRogueAbStrikes
+            write-ini.string f "live" "s" line
+            undim line
+            undim f
+        }
+        sleep-for 20
+    } until (quit == 1)
+}
