+; ===== Roguelite bridge: poll for a setup file written by the browser wrapper =====
+local-script RogueWatch@2400 {
+    var f seq
+
+    sprintf f "%srogue_in.ini" gSaveGamePath
+    ; wait for the boot intro and asset/team-data init to finish
+    break-until (gMLBTeamData && not (script-running smth_init) && not (script-running PlayMovieAndStartMusic))
+    ; a rogue game was left without a result (quit/back-out): put the player straight back in
+    if gRoguePending {
+        undim f
+        start-script RogueApply
+        stop-script 0
+    }
+    do {
+        seq = read-ini.i32 f "setup" "seq"
+        if (seq > gRogueSeq) {
+            gRogueSeq = seq
+            undim f
+            start-script RogueApply
+            stop-script 0
+        }
+        sleep-for 30
+    } until (seq == -99999)
+}
+
+local-script RogueBootSkipIntro@2402 {
+    var f v
+
+    sprintf f "%srogue_in.ini" gSaveGamePath
+    v = read-ini.i32 f "boot" "skipintro"
+    undim f
+    return v
+}
+
+local-script RogueApply@2401 {
+    var f key i n k c d v fld
+
+    sprintf f "%srogue_in.ini" gSaveGamePath
+    gRogueActive = 1
+    gRoguePending = 1
+    gGameMode = MODE-PICKUP
+    gRogueMercy = read-ini.i32 f "setup" "mercy"
+    gRogueIFS = read-ini.i32 f "setup" "ifs"
+    gRogueDump = 0
+    gRogueSwat = 0
+    ; CPU custom players: these kid ids get a new name, and one may be the ace
+    gRogueCK1 = read-ini.i32 f "names" "k0"
+    gRogueCK2 = read-ini.i32 f "names" "k1"
+    gRogueCK3 = read-ini.i32 f "names" "k2"
+    gRogueAce = read-ini.i32 f "names" "ace"
+    gNoCommentary = read-ini.i32 f "audio" "nocommentary"
+    gNoGooch = read-ini.i32 f "audio" "nogooch"
+    gNoBackgroundSound = read-ini.i32 f "audio" "nobackground"
+    gNoPlayerTalking = read-ini.i32 f "audio" "noplayertalking"
+    gNoPlayerChatter = read-ini.i32 f "audio" "noplayerchatter"
+    gNoMusic = read-ini.i32 f "audio" "nomusic"
+    if gNoMusic {
+        stop-sound 10000
+    }
+    if (read-ini.i32 f "setup" "autoplay") {
+        gGameMode = MODE-SPECTATE
+    }
+    gGameLength = read-ini.i32 f "setup" "halfinnings"
+    if (gGameLength < 2) {
+        gGameLength = 12
+    }
+    gDifficulty = read-ini.i32 f "setup" "difficulty"
+    if (gDifficulty == 0) {
+        gDifficulty = MEDIUM
+    }
+    gNoErrors = read-ini.i32 f "setup" "noerrors"
+    for i = 0 to 8 + {
+        sprintf key "u%d" i
+        gPickOrder1[i] = read-ini.i32 f "team" key
+        sprintf key "ub%d" i
+        gBattingOrder1[i] = read-ini.i32 f "team" key
+        sprintf key "c%d" i
+        gPickOrder2[i] = read-ini.i32 f "team" key
+        sprintf key "cb%d" i
+        gBattingOrder2[i] = read-ini.i32 f "team" key
+    }
+    gVisitorInfoIndex = 0
+    gHomeInfoIndex = 1
+    gTeamInfo[0][TI-FIELDING-ORDER] = gPickOrder1
+    gTeamInfo[1][TI-FIELDING-ORDER] = gPickOrder2
+    gTeamInfo[0][TI-BATTING-ORDER-KIDS] = gBattingOrder1
+    gTeamInfo[1][TI-BATTING-ORDER-KIDS] = gBattingOrder2
+    gTeamInfo[1][TI-TEAM-NOUN] = 0
+    gTeamInfo[1][TI-TEAM-ADJECTIVE] = 0
+    k = read-ini.i32 f "name" "noun"
+    if (k > 0) {
+        gTeamInfo[0][TI-TEAM-NOUN] = k
+        gTeamInfo[0][TI-TEAM-ADJECTIVE] = read-ini.i32 f "name" "adj"
+        gRogueC1 = 0
+        gRogueC2 = 0
+        if (k > 121) {
+            ; MLB names: real colors unless the player picked some (0 = keep the team's own)
+            start-script PopulateMLBTeamData
+            c = read-ini.i32 f "name" "color1"
+            if (c > 0 && c < 126) {
+                gMLBTeamData[k][7] = c
+                gMLBTeamData[k][10] = c
+            }
+            c = read-ini.i32 f "name" "color2"
+            if (c > 0 && c < 126) {
+                gMLBTeamData[k][8] = c
+            }
+            gTeamInfo[0][TI-PRIMARY-COLOR] = gMLBTeamData[k][4]
+            gTeamInfo[0][TI-SECONDARY-COLOR] = gMLBTeamData[k][5]
+        } else {
+            ; pro colors (101+) go through gRogueC1/C2; screens that only know the 9 basic colors get the closest one
+            c = read-ini.i32 f "name" "color1"
+            if (c >= 101) {
+                gRogueC1 = c
+                c = read-ini.i32 f "name" "basic1"
+            }
+            gTeamInfo[0][TI-PRIMARY-COLOR] = c
+            c = read-ini.i32 f "name" "color2"
+            if (c >= 101) {
+                gRogueC2 = c
+                c = read-ini.i32 f "name" "basic2"
+            }
+            gTeamInfo[0][TI-SECONDARY-COLOR] = c
+        }
+    } else {
+        gTeamInfo[0][TI-TEAM-NOUN] = 0
+    }
+    ; the page picks the other team's name and colors so it knows which kid bonuses apply
+    k = read-ini.i32 f "name" "cpunoun"
+    if (k > 0) {
+        gTeamInfo[1][TI-TEAM-NOUN] = k
+        gTeamInfo[1][TI-TEAM-ADJECTIVE] = read-ini.i32 f "name" "cpuadj"
+        if (k > 121) {
+            if (gMLBTeamData == 0) {
+                start-script PopulateMLBTeamData
+            }
+            c = read-ini.i32 f "name" "cpuc1"
+            if (c > 0 && c < 126) {
+                gMLBTeamData[k][7] = c
+                gMLBTeamData[k][10] = c
+            }
+            c = read-ini.i32 f "name" "cpuc2"
+            if (c > 0 && c < 126) {
+                gMLBTeamData[k][8] = c
+            }
+            gTeamInfo[1][TI-PRIMARY-COLOR] = gMLBTeamData[k][4]
+            gTeamInfo[1][TI-SECONDARY-COLOR] = gMLBTeamData[k][5]
+        } else {
+            gTeamInfo[1][TI-PRIMARY-COLOR] = read-ini.i32 f "name" "cpuc1"
+            gTeamInfo[1][TI-SECONDARY-COLOR] = read-ini.i32 f "name" "cpuc2"
+        }
+    }
+    ; kid bonuses check the park, team names and colors, so set those first
+    gField = read-ini.i32 f "setup" "field"
+    start-script maybe_kid_bonuses
+    if (read-ini.i32 f "setup" "hotcold") {
+        start-script maybe_stat_ups_downs
+    }
+    gKidData[0][33] = 1
+    n = read-ini.i32 f "mods" "n"
+    if (n > 0) {
+        for i = 0 to (n - 1) + {
+            sprintf key "k%d" i
+            k = read-ini.i32 f "mods" key
+            sprintf key "c%d" i
+            c = read-ini.i32 f "mods" key
+            sprintf key "d%d" i
+            d = read-ini.i32 f "mods" key
+            sprintf key "s%d" i
+            if (read-ini.i32 f "mods" key) {
+                v = d
+            } else {
+                v = gKidData[k][c] + d
+            }
+            gKidData[k][c] = max 0 (min v 125)
+        }
+    }
+    fld = read-ini.i32 f "setup" "field"
+    undim f
+    undim key
+    start-script StartQuickPickupGame (fld + 1)
+}
