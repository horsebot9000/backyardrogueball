+local-script RogueCalcBoost@2423 {
+    var i k c m on
+
+    if (gBatterKid != gRogueAbKid) {
+        gRogueAbKid = gBatterKid
+        gRogueAbPitches = 0
+        gRogueAbFouls = 0
+        gRogueAbStrikes = 0
+    }
+    on = 0
+    if gBases {
+        for i = 1 to 3 + {
+            if (gBases[i][BASE-RUNNERIDX] != 999) {
+                inc on
+            }
+        }
+    }
+    gRogueOn = on
+    gRogueBP = 0
+    gRogueBC = 0
+    gRogueDbl = 0
+    gRogueTrp = 0
+    for i = 0 to 8 + {
+        k = gPickOrder1[i]
+        if (k > 0) {
+            gRogueDbl = gRogueDbl + gGameStats[k][STAT-DOUBLES]
+            gRogueTrp = gRogueTrp + gGameStats[k][STAT-TRIPLES]
+        }
+    }
+    if (gBattingTeamInfoIndex != 0 || gRogueCondN < 1) {
+        stop-script 0
+    }
+    for i = 0 to (gRogueCondN - 1) + {
+        k = gRogueCond[i][0]
+        if (k == 0 || k == gBatterKid) {
+            c = gRogueCond[i][1]
+            m = 0
+            case c {
+                1 {
+                    if (on > 0) {
+                        m = 1
+                    }
+                }
+                2 {
+                    if (on == 3) {
+                        m = 1
+                    }
+                }
+                3 {
+                    if (gRogueAbPitches == 0) {
+                        m = 1
+                    }
+                }
+                4 {
+                    if (gCurrentHalfInning < 2) {
+                        m = 1
+                    }
+                }
+                5 {
+                    if (in gCurrentSwing [SWING-LINE-DRIVE SWING-SCREAMING-LINE-DRIVE]) {
+                        m = 1
+                    }
+                }
+                6 {
+                    if (in gCurrentSwing [SWING-GROUNDER SWING-UNDERGROUNDER]) {
+                        m = 1
+                    }
+                }
+                7 {
+                    m = gRogueAbFouls
+                }
+                9 {
+                    if (gNumStrikes == 2) {
+                        m = 1
+                    }
+                }
+                10 {
+                    if (gNumBalls == 3 && gNumStrikes == 2) {
+                        m = 1
+                    }
+                }
+                11 {
+                    m = gNumBalls - (min gNumStrikes gRogueAbStrikes)
+                }
+                12 {
+                    m = gRogueDbl
+                }
+                13 {
+                    m = gRogueTrp
+                }
+                8 {
+                    ; momentum: +1 per hit, -1 per out this game (outs = at bats without a hit)
+                    m = 2 * gGameStats[gBatterKid][STAT-HITS] - gGameStats[gBatterKid][STAT-AT-BATS]
+                }
+            }
+            gRogueBP = gRogueBP + m * gRogueCond[i][2]
+            gRogueBC = gRogueBC + m * gRogueCond[i][3]
+        }
+    }
+}
+
+local-script RoguePitchDone@2425 {
+    if (gBatterKid != gRogueAbKid) {
+        gRogueAbKid = gBatterKid
+        gRogueAbPitches = 0
+        gRogueAbFouls = 0
+        gRogueAbStrikes = 0
+    }
+    inc gRogueAbPitches
+    if rBatterSwung {
+        if gBallIsFoul {
+            inc gRogueAbFouls
+        } else if (not gBallWasHit) {
+            inc gRogueAbStrikes
+        }
+    } else if (rBallOrStrike == 1) {
+        inc gRogueAbStrikes
+    }
+}
+
