 Common::SeekableReadStream *ScummEngine_v60he::openSaveFileForReading(const byte *fileName) {
+	// Roguelite bridge: files named rogue_* are written by the browser wrapper while the
+	// game runs, so bypass the save-file manager's directory cache and read from disk.
+	{
+		Common::String conv = convertSavePath(fileName);
+		if (conv.contains("-rogue_")) {
+			Common::FSNode node = Common::FSNode(ConfMan.getPath("savepath")).getChild(conv);
+			if (!node.exists())
+				return nullptr;
+			Common::SeekableReadStream *s = node.createReadStream();
+			return s ? Common::wrapCompressedReadStream(s) : nullptr;
+		}
+	}
+
 	Common::SeekableReadStream *file = _saveFileMan->openForLoading(convertSavePath(fileName));
 
